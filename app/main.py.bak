# ---- Phase10: /chat back-compat shim (forwards to /chat_v15) ----
from fastapi import Request, Header
from fastapi.responses import JSONResponse, RedirectResponse
try:
    import httpx as _httpx
    _HAS_HTTPX = True
except Exception:  # keep server booting even if httpx absent
    _HAS_HTTPX = False

@app.post("/chat")
async def chat_alias(request: Request, x_agent_token: str = Header(default=None)):
    # If httpx isn't installed, fall back to a 307 redirect that preserves POST.
    if not _HAS_HTTPX:
        return RedirectResponse(url="/chat_v15", status_code=307)

    body = await request.json()
    headers = {"Content-Type": "application/json"}
    if x_agent_token:
        headers["X-Agent-Token"] = x_agent_token

    async with _httpx.AsyncClient() as client:
        r = await client.post(
            "http://127.0.0.1:8000/chat_v15",
            headers=headers,
            json=body,
            timeout=30
        )
    # Pass-through status + JSON so clients see the same shape as /chat_v15
    return JSONResponse(status_code=r.status_code, content=r.json())
# ---- end back-compat shim ----

# ---- Phase10: /ops/links (read-only) ----
import json, os
from pathlib import Path

LINKS_PATH = os.getenv("OPERATOR_LINKS_PATH") or str(Path(os.getenv("DATA_DIR", "/app/data")) / "operator_links.json")

@app.get("/ops/links")
def ops_links():
    try:
        p = Path(LINKS_PATH)
        if not p.exists():
            return {"links": []}
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        # Never take the service down for ops links
        return {"links": []}
# ---- end /ops/links ----
# --- Admin: save OpenAI key into /app/.env (POST-only) ---
from fastapi import Form
from pathlib import Path


from fastapi.responses import RedirectResponse
@app.post("/admin/key")
def _admin_key_alias():
    # unify on the authenticated JSON endpoint
    return RedirectResponse(url="/admin/config", status_code=307)


async def set_openai_key(openai_key: str = Form(...)):
    """
    Saves a new OpenAI API key into /app/.env inside the container.
    The Admin page will call this with a POST; GET is not defined.
    """
    env_path = Path("/app/.env")
    lines = env_path.read_text().splitlines() if env_path.exists() else []
    new_lines = [l for l in lines if not l.startswith("OPENAI_API_KEY=")]
    new_lines.append(f"OPENAI_API_KEY={openai_key.strip()}")
    env_path.write_text("\n".join(new_lines) + "\n")
    return {"status": "saved"}

# ----------------------------
# Phase10: real model chat API
# ----------------------------
import os
from typing import Optional
from pydantic import BaseModel
from fastapi import Header, HTTPException, status

try:
    from openai import OpenAI
    _oa_client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))
except Exception as _e:
    _oa_client = None

class ChatRequest(BaseModel):
    message: str
    system: Optional[str] = None

def _require_token(x_agent_token: Optional[str]):
    expected = os.getenv("AGENT_TOKEN", "jensen4254")
    if not x_agent_token or x_agent_token != expected:
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Invalid token")

@app.post("/chat_live")
async def chat_live(body: ChatRequest, x_agent_token: Optional[str] = Header(None, alias="X-Agent-Token")):
    """
    Real model-backed chat using OpenAI. Leaves /chat unchanged (demo) for safety.
    """
    _require_token(x_agent_token)

    if _oa_client is None:
        # Library not available or key missing; don't crash the service.
        return {"reply": "Model client unavailable. Check OPENAI_API_KEY and requirements.", "route": "error"}

    sys_msg = body.system or "You are Jensen Agent. Answer briefly and helpfully."
    try:
        resp = _oa_client.chat.completions.create(
            model=os.getenv("OPENAI_MODEL", "gpt-4o-mini"),
            messages=[
                {"role": "system", "content": sys_msg},
                {"role": "user", "content": body.message},
            ],
            temperature=float(os.getenv("OPENAI_TEMPERATURE", "0.7")),
            max_tokens=int(os.getenv("OPENAI_MAX_TOKENS", "256")),
        )
        text = resp.choices[0].message.content if resp and resp.choices else "(no content)"
        return {"reply": text, "route": "live", "summary": f"User asked: {body.message[:90]}"}
    except Exception as e:
        return {"reply": f"OpenAI error: {type(e).__name__}: {e}", "route": "error"}

# ----------------------------
# Phase10: real model chat API (header-safe)
# ----------------------------
from fastapi import Request

@app.post("/chat_live2")
async def chat_live2(body: ChatRequest, request: Request):
    """
    Same as /chat_live but fetches X-Agent-Token directly from headers.
    """
    # Accept both cases just in case: X-Agent-Token / x-agent-token
    token = request.headers.get("x-agent-token") or request.headers.get("X-Agent-Token")
    _require_token(token)

    if _oa_client is None:
        return {"reply": "Model client unavailable. Check OPENAI_API_KEY and requirements.", "route": "error"}

    sys_msg = body.system or "You are Jensen Agent. Answer briefly and helpfully."
    try:
        resp = _oa_client.chat.completions.create(
            model=os.getenv("OPENAI_MODEL", "gpt-4o-mini"),
            messages=[
                {"role": "system", "content": sys_msg},
                {"role": "user", "content": body.message},
            ],
            temperature=float(os.getenv("OPENAI_TEMPERATURE", "0.7")),
            max_tokens=int(os.getenv("OPENAI_MAX_TOKENS", "256")),
        )
        text = resp.choices[0].message.content if resp and resp.choices else "(no content)"
        return {"reply": text, "route": "live2", "summary": f"User asked: {body.message[:90]}"}
    except Exception as e:
        return {"reply": f"OpenAI error: {type(e).__name__}: {e}", "route": "error"}

