def _ctx(request: Request, user: str, **extra):
    base = {
        "request": request,
        "user": user,
        "token": AGENT_TOKEN,
        "version": APP_VERSION,
        "key_status": ("present (hidden)" if OPENAI_API_KEY else "not set"),
    }
    base.update(extra)
    return base

