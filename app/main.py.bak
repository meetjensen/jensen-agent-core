# --- final override: /ui/admin/links guarded & idempotent ---
from fastapi.responses import HTMLResponse
from fastapi import Depends, Request

@app.get("/ui/admin/links", response_class=HTMLResponse)
async def ui_admin_links_safe(request: Request, user: str = Depends(require_login)):
    # If helper exists, use it; else serve template fallback
    if "get_admin_links_page" in globals() and callable(get_admin_links_page):
        return get_admin_links_page()
    return templates.TemplateResponse("admin_links.html", _ctx(request, user, title="Links & Integrations"))

