# === HARD-ATTACH: /diag/env (defined on the final app) ===
import os
from fastapi.responses import JSONResponse

def _mask(k: str, v: str) -> str:
    if not isinstance(v, str):
        return v
    kU = k.upper()
    # mask likely secrets
    if any(t in kU for t in ["KEY", "TOKEN", "SECRET", "PASSWORD", "PASS", "CREDENTIAL", "AWS_SECRET"]):
        if len(v) <= 8:
            return "*****"
        return v[:4] + "…" + v[-4:]
    return v

@app.get("/diag/env")
def _diag_env():
    data = {}
    for k, v in sorted(os.environ.items()):
        data[k] = _mask(k, v)
    return JSONResponse({"env": data})
# === end hard-attach ===

# === HARD-ATTACH: /diag/env (defined on the final app) ===
import os
from fastapi.responses import JSONResponse

def _mask(k: str, v: str) -> str:
    if not isinstance(v, str):
        return v
    kU = k.upper()
    # mask likely secrets
    if any(t in kU for t in ["KEY", "TOKEN", "SECRET", "PASSWORD", "PASS", "CREDENTIAL", "AWS_SECRET"]):
        if len(v) <= 8:
            return "*****"
        return v[:4] + "…" + v[-4:]
    return v

@app.get("/diag/env")
def _diag_env():
    data = {}
    for k, v in sorted(os.environ.items()):
        data[k] = _mask(k, v)
    return JSONResponse({"env": data})
# === end hard-attach ===


# This mounts a proper Prometheus endpoint that returns the correct content-type
# and real newlines (no JSON escaping), so Prometheus can parse the samples.
try:
    from prometheus_client import make_asgi_app
    app.mount("/metrics", make_asgi_app())
except Exception as _e:
    # If prometheus_client isn't available, leave a clear error for the logs.
    # (The container image should already include it; if not, tell me and I’ll
    # give you a minimal PlainTextResponse-based fallback.)
    pass

# === Request counters exported to Prometheus ===
# Counts successful vs errored HTTP requests the agent serves.
try:
    from prometheus_client import Counter

    REQUESTS_OK = Counter("jensen_requests_ok_total", "Successful agent requests")
    REQUESTS_ERR = Counter("jensen_requests_error_total", "Errored agent requests")

    @app.middleware("http")
    async def _count_requests_mw(request, call_next):
        try:
            response = await call_next(request)
            # treat <400 as OK, >=400 as error
            if getattr(response, "status_code", 500) < 400:
                REQUESTS_OK.inc()
            else:
                REQUESTS_ERR.inc()
            return response
        except Exception:
            REQUESTS_ERR.inc()
            raise
except Exception:
    # If prometheus_client missing for some reason, skip silently (the image includes it).
    pass

# === METRICS (consolidated) — single /metrics endpoint ==============================
from fastapi.responses import Response
from typing import Dict

# In-memory request counters we will expose from /metrics
_REQUESTS_OK = 0
_REQUESTS_ERR = 0

@app.middleware("http")
async def _count_requests_mw(request, call_next):
    global _REQUESTS_OK, _REQUESTS_ERR
    try:
        resp = await call_next(request)
        if getattr(resp, "status_code", 500) < 400:
            _REQUESTS_OK += 1
        else:
            _REQUESTS_ERR += 1
        return resp
    except Exception:
        _REQUESTS_ERR += 1
        raise

def _job_counters() -> Dict[str, int]:
    """
    Pull job counters from your DB helper. If it’s missing or errors, return zeros
    so Prometheus/Grafana always see the series.
    """
    try:
        from app.metrics_db import job_counters as _jobc
        return _jobc()
    except Exception:
        return {"total": 0, "queued": 0, "running": 0, "ok": 0, "error": 0}

# Drop any previously-registered GET /metrics so we control the output
try:
    app.router.routes = [
        r for r in app.router.routes
        if not (getattr(r, "path", None) == "/metrics" and "GET" in getattr(r, "methods", set()))
    ]
except Exception:
    pass

@app.get("/metrics", include_in_schema=False)
def metrics():
    c = _job_counters()
    done = c.get("ok", 0)  # expose done==ok for compatibility
    lines = [
        "# HELP jensen_info Build info.",
        "# TYPE jensen_info gauge",
        f'jensen_info{{version="{APP_VERSION}"}} 1',

        "# HELP jensen_jobs_total Jobs currently tracked.",
        "# TYPE jensen_jobs_total gauge",
        f'jensen_jobs_total {c.get("total", 0)}',

        "# HELP jensen_jobs_status Jobs by status.",
        "# TYPE jensen_jobs_status gauge",
        f'jensen_jobs_status{{status="queued"}} {c.get("queued", 0)}',
        f'jensen_jobs_status{{status="running"}} {c.get("running", 0)}',
        f'jensen_jobs_status{{status="ok"}} {c.get("ok", 0)}',
        f'jensen_jobs_status{{status="done"}} {done}',
        f'jensen_jobs_status{{status="error"}} {c.get("error", 0)}',

        "# HELP jensen_requests_ok_total Successful agent requests.",
        "# TYPE jensen_requests_ok_total counter",
        f'jensen_requests_ok_total {_REQUESTS_OK}',

        "# HELP jensen_requests_error_total Errored agent requests.",
        "# TYPE jensen_requests_error_total counter",
        f'jensen_requests_error_total {_REQUESTS_ERR}',
        
        "# HELP jensen_start_time_seconds UNIX epoch of process start.",
        "# TYPE jensen_start_time_seconds gauge",
        f"jensen_start_time_seconds {int(START_TS)}",

        "# HELP jensen_uptime_seconds Process uptime in seconds.",
        "# TYPE jensen_uptime_seconds gauge",
        f"jensen_uptime_seconds {int(time.time() - START_TS)}",

        "# HELP jensen_process_cpu_seconds_total Total user+system CPU seconds.",
        "# TYPE jensen_process_cpu_seconds_total counter",
        f"jensen_process_cpu_seconds_total {time.process_time():.3f}",

        "# HELP jensen_memory_bytes Resident set size in bytes.",
        "# TYPE jensen_memory_bytes gauge",
        f"jensen_memory_bytes {_rss_bytes()}",

    ]
    return Response(content="\n".join(lines) + "\n", media_type="text/plain; version=0.0.4")
# === END METRICS =======================================================================
