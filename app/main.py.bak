# ---- Harden /ui/admin/links routing (dedupe + secure) ----
try:
    from fastapi import Depends, Request
    from fastapi.responses import HTMLResponse, Response
    def _install_links_route():
        # Drop any existing GET mapping(s) for /ui/admin/links (dedupe)
        try:
            new_routes = []
            for r in app.router.routes:
                try:
                    if getattr(r, "path", None) == "/ui/admin/links" and "GET" in getattr(r, "methods", set()):
                        continue
                except Exception:
                    pass
                new_routes.append(r)
            app.router.routes = new_routes
        except Exception:
            pass

        @app.get("/ui/admin/links", response_class=HTMLResponse)
        def _links_page(request: Request, user: str = Depends(require_login)):
            return templates.TemplateResponse("admin_links.html", _ctx(request, user, title="Links & Integrations"))

        @app.head("/ui/admin/links", include_in_schema=False)
        def _links_head(user: str = Depends(require_login)):
            return Response(status_code=200)

    _install_links_route()
except Exception:
    pass
# ---- end harden block ----


